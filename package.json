{
  "name": "vibetodo",
  "version": "0.1.0",
  "description": "A desktop command center for vibe-coding TODOs",
  "main": "electron/main.js",
  "author": "VibeTodo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.vibetodo.app",
    "productName": "VibeTodo",
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "python/dist",
        "to": "python",
        "filter": ["**/*"]
      }
    ],
    "win": { "target": "nsis" },
    "mac": { "target": "dmg" },
    "linux": { "target": "AppImage" }
  }
}
